# Copy this file to ".env" and fill in what you have. Anything left empty uses the local fallback.

# Where the site runs (used in password-reset links). Locally: http://localhost:5000
BASE_URL=http://localhost:5000
PORT=5000

# --- Turso database (empty = local file data/ekarolbagh.db) ---
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# --- Cloudflare R2 for product photos (optional; empty = photos are stored in the database, i.e. Turso) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public address of the bucket, e.g. https://images.ekarolbagh.in or https://pub-xxxx.r2.dev
R2_PUBLIC_URL=

# --- Resend for emails (empty = emails are printed in the server window) ---
RESEND_API_KEY=
MAIL_FROM=eKarolBagh <orders@ekarolbagh.in>
